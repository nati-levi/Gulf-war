# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file — it holds your bank/credit-card login.

# Which institution to scrape. One of:
#   hapoalim, leumi, discount, mercantile, mizrahi, otsarHahayal,
#   visaCal, max, isracard, amex, union, beinleumi, massad, yahav,
#   beyahadBishvilha, pagi, behatsdaa
COMPANY_ID=max

# How far back to fetch transactions from (YYYY-MM-DD).
START_DATE=2026-01-01

# Show the actual browser window while scraping (useful for debugging a
# failed login). Set to false to run headless.
SHOW_BROWSER=false

# --- Credentials ---
# Only fill in the fields required for your chosen COMPANY_ID (see README
# for the field->company table). Leave the rest blank.
CREDS_ID=
CREDS_USERNAME=
CREDS_PASSWORD=
CREDS_USER_CODE=
CREDS_NATIONAL_ID=
CREDS_CARD6_DIGITS=
CREDS_NUM=
